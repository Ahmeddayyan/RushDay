{
  "ConnectionStrings": {
    "RushDay": "Host=localhost;Port=5432;Database=rushday;Username=rushday;Password=rushday"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Database": {
    "MigrateOnStartup": false,
    "SeedOnStartup": false,
    "BackfillOnStartup": false,
    "SeedStudentCount": 20000,
    "SeedResultsDay": "2026-09-28T09:00:00Z",
    "MaxPoolSize": 40
  },
  "Demo": {
    "Enabled": true
  },
  "Bootstrap": {
    "AdminUsername": "admin"
  },
  "Branding": {
    "InstitutionName": "RushDay Demo University",
    "InstitutionShortName": "RushDay",
    "TimeZone": "Europe/London"
  },
  "RateLimiting": {
    "MaxConcurrent": 64,
    "MaxQueued": 1024,
    "LoginPerIpPerMinute": 100000,
    "LoginPerUserPerMinute": 100000,
    "LoginFailuresPerIpPer10Minutes": 100000,
    "LockoutDistinctIps": 3,
    "LoginConcurrency": 64,
    "LoginQueue": 512,
    "PasswordChangePerUserPerMinute": 1000,
    "EnrolPerUserPer10s": 1000,
    "WritePerUserPerMinute": 10000,
    "HealthReadyPerIpPerMinute": 100000,
    "OpsMetricsPer2s": 1
  },
  "Auth": {
    "SessionSlidingHours": 8,
    "SessionAbsoluteHours": 12,
    "AdminSessionSlidingMinutes": 60,
    "AdminSessionAbsoluteHours": 8,
    "SecurityStampIntervalMinutes": 5,
    "RequireMfaForRoles": [ "Admin" ],
    "MfaCookieMinutes": 5
  },
  "Security": {
    "TrustForwardedHeaders": true
  }
}
